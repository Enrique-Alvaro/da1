# Variables for docker compose (copy to .env in repo root)
# docker compose reads this file automatically from the project root.

# --- SQL Server ---
# Must meet SQL Server complexity: upper, lower, digit, symbol, 8+ chars
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=CrownBid
MSSQL_PUBLISH_PORT=1433

# --- API host port (Nginx proxies HTTPS → this port) ---
API_HOST_PORT=3000

# --- API secrets (required) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# --- Employee admin (must exist in dbo.empleados after seed) ---
EMPLOYEE_ADMIN_EMAIL=admin@crownbid.local
EMPLOYEE_ADMIN_PASSWORD=CHANGE_ME_EMPLOYEE_PASSWORD
EMPLOYEE_ADMIN_ID=1
DEFAULT_REVIEWER_EMPLOYEE_ID=1

# --- Optional ---
# COMPANY_CLIENT_ID=1
# FRONTEND_URL=https://app.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
