{
  "name": "crownbid-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "db:schema": "echo \"Run database/schema.sql in SQL Server\"",
    "dev:api": "npm --workspace @crownbid/api run dev",
    "dev:mobile": "npm --workspace @crownbid/mobile run start",
    "start": "npm --workspace @crownbid/mobile run start",
    "android": "npm --workspace @crownbid/mobile run android",
    "ios": "npm --workspace @crownbid/mobile run ios",
    "web": "npm --workspace @crownbid/mobile run web",
    "expo": "node scripts/expo-mobile.mjs",
    "lint": "npm --workspace @crownbid/mobile run lint",
    "reset-project": "node ./scripts/reset-project.js"
  }
}
