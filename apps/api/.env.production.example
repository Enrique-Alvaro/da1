# CrownBid API — production environment (Docker Compose / Ubuntu server)
# Copy to apps/api/.env.production and fill in secrets. NEVER commit .env.production.

NODE_ENV=production
PORT=3000

# --- SQL Server (Docker service name: sqlserver) ---
# Option A (recommended in Docker): individual parts — env.ts builds the ADO connection string.
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=CrownBid
DB_USER=sa
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Option B (local dev / single var): full ADO connection string (overrides Option A if set).
# SQLSERVER_CONNECTION_STRING=Server=sqlserver,1433;Database=CrownBid;User Id=sa;Password=CHANGE_ME_STRONG_PASSWORD;Encrypt=true;TrustServerCertificate=true

# --- Auth (required in production) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# --- Employee admin login (must exist in dbo.empleados) ---
EMPLOYEE_ADMIN_EMAIL=admin@crownbid.local
EMPLOYEE_ADMIN_PASSWORD=CHANGE_ME_EMPLOYEE_PASSWORD
EMPLOYEE_ADMIN_ID=1

# --- Product submissions (FK productos.revisor) ---
DEFAULT_REVIEWER_EMPLOYEE_ID=1

# --- Optional: company buyer when closing items without bids ---
# COMPANY_CLIENT_ID=1

# --- Email (required for register / password reset in production) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=noreply@example.com

# --- Password reset links (public URL of your app or landing page) ---
# FRONTEND_URL=https://app.example.com
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- CORS ---
# The API uses cors({ origin: "*" }) in app.ts. No env var required today.
# If you add CORS_ORIGIN later, set it here.
